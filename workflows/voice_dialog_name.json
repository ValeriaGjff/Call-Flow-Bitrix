        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"modelUri\": \"gpt://{{$('Edit Fields').first().json.ID_CAT}}/yandexgpt-lite\",\n  \"completionOptions\": {\n    \"stream\": false,\n    \"temperature\": 0,\n    \"maxTokens\": 150\n  },\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"text\": \"Извлеки имя клиента из текста. Верни только валидный JSON: {\\\"clientName\\\":\\\"string|null\\\"}. Если имени нет, верни {\\\"clientName\\\":null}.\"\n    },\n    {\n      \"role\": \"user\",\n      \"text\": \"Ответ клиента: {{$('Edit Fields').first().json.userText}}\"\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -416,
        64
      ],
      "id": "5ea09c52-79fd-4871-9f6e-144b0ad76996",
      "name": "Extract Name"
    },
    {
      "parameters": {
        "jsCode": "let raw = $json.result?.alternatives?.[0]?.message?.text || '';\nraw = raw.trim();\n\nlet clientName = null;\n\ntry {\n  raw = raw\n    .replace(/^```json\\s*/i, '')\n    .replace(/^```/, '')\n    .replace(/```$/i, '')\n    .trim();\n\n  const start = raw.indexOf('{');\n  const end = raw.lastIndexOf('}');\n\n  if (start !== -1 && end !== -1) {\n    const parsed = JSON.parse(raw.slice(start, end + 1));\n    clientName = parsed.clientName || null;\n  }\n} catch (e) {\n  clientName = null;\n}\n\nif (!clientName) {\n  clientName = String($('Edit Fields').first().json.userText || '')\n    .replace(/^(меня зовут|я|это|алло|здравствуйте|добрый день|добрый вечер)\\s+/i, '')\n    .trim();\n}\n\nif (!clientName || clientName.length < 2) {\n  clientName = 'Клиент';\n}\n\nreturn [\n  {\n    json: {\n      phone: $('Edit Fields').first().json.phone,\n      clientName,\n      userText: $('Edit Fields').first().json.userText\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
