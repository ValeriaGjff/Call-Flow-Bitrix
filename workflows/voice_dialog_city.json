      "name": "Send To Lead Workflow1"
    },
    {
      "parameters": {
        "jsCode": "const row = $('Get Final Dialog Row').first().json;\n\nconst clientType = String(row.clientType || '').toUpperCase();\nconst city = String(row.city || '').toLowerCase().trim();\n\nconst isAllowedCity =\n  city.includes('city a') ||\n  city.includes('city b');\n\nconst shouldReject =\n  clientType === 'PERSON' &&\n  !isAllowedCity;\n\nreturn [\n  {\n    json: {\n      ...row,\n      clientType,\n      city: row.city || 'UNKNOWN',\n      isAllowedCity,\n      shouldReject\n    }\n  }\n];"
      },
