    {
      "parameters": {
        "jsCode": "let text = String($('Edit Fields').first().json.userText || '').toLowerCase().trim();\n\ntext = text\n  .replace(/[.,!?]/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim();\n\nlet city = 'UNKNOWN';\n\nif (\n  text.includes('city a') ||\n  text.includes('citya') ||\n  text.includes('citya') ||\n  text.includes('citya')\n) {\n  city = 'City A';\n} else if (\n  text.includes('city b') ||\n  text.includes('city b') ||\n  text.includes('city b')\n) {\n  city = 'City B';\n} else if (text.length >= 2) {\n  city = $('Edit Fields').first().json.userText.trim();\n}\n\nreturn [\n  {\n    json: {\n      phone: $('Edit Fields').first().json.phone,\n      city,\n      userText: $('Edit Fields').first().json.userText\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
