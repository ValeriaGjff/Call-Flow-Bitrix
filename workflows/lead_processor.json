    {
      "parameters": {
        "jsCode": "const phone = $('Edit Fields').first().json.phone || '';\nconst clientName = $('Edit Fields').first().json.clientName || 'Клиент';\n\nlet clientType = $('Edit Fields').first().json.clientType || 'UNKNOWN';\n\nif (!clientType || clientType === 'UNKNOWN' || clientType === 'null' || clientType === 'undefined') {\n  clientType = 'PERSON';\n}\n\nconst city = $('Edit Fields').first().json.city || '';\nconst transcript = $('Edit Fields').first().json.transcript || '';\nconst source = $('Edit Fields').first().json.source || 'telephony_sip';\n\nconst summaryParts = [];\n\nif (clientName) summaryParts.push(`Имя: ${clientName}`);\nif (clientType) summaryParts.push(`Тип клиента: ${clientType}`);\nif (city) summaryParts.push(`Город: ${city}`);\n\nreturn [\n  {\n    json: {\n      phone,\n      clientName,\n      clientType,\n      city,\n      transcript,\n      source,\n      needCallback: true,\n      summary: summaryParts.join('\\n')\n    }\n  }\n];"
      },
