        0
      ],
      "id": "e7ad69b3-ccf1-4b1f-965b-7366ce01ed57",
      "name": "Build Timeline Comment1"
    },
    {
      "parameters": {
        "jsCode": "const data = $('Parse Lead Data').first().json;\nconst dutyData = $('Get row(s)').first().json;\n\n// Demo configuration.\n// Replace this with your own CRM users or load the same structure from a config/Data Table.\nconst B2C_MANAGER = { id: 103, name: 'Manager C', ext: '203' };\n\nconst MANAGERS = [\n  { id: 101, name: 'Manager A', ext: '201' },\n  { id: 102, name: 'Manager B', ext: '202' },\n  { id: 104, name: 'Manager D', ext: '204' },\n  { id: 105, name: 'Manager E', ext: '205' }\n];\n\nlet dutyTurn = String(dutyData.value || '1');\nconst TIME_ZONE = 'UTC';\n\nfunction localDateKey() {\n  return new Intl.DateTimeFormat('en-CA', {\n    timeZone: TIME_ZONE,\n    year: 'numeric',\n    month: '2-digit',\n    day: '2-digit'\n  }).format(new Date());\n}\n\n// Deterministic demo rotation. Production deployments can replace this\n// with a calendar, database table or workforce-management API.\nconst dutyDate = localDateKey();\nconst dayNumber = Math.floor(new Date(`${dutyDate}T12:00:00Z`).getTime() / 86400000);\nconst primaryIndex = Math.abs(dayNumber) % MANAGERS.length;\nconst secondaryIndex = (primaryIndex + 1) % MANAGERS.length;\n\nconst primaryCandidate = MANAGERS[primaryIndex];\nconst secondaryCandidate = MANAGERS[secondaryIndex];\n\nlet assignedById;\nlet assignedByName;\nlet nextDutyTurn = dutyTurn;\nlet assignedExt = '';\nlet secondaryExt = '';\nlet fallbackExts = '';\n\nif (data.clientType === 'COMPANY') {\n  const primaryManager = dutyTurn === '1' ? primaryCandidate : secondaryCandidate;\n  const secondaryManager = dutyTurn === '1' ? secondaryCandidate : primaryCandidate;\n\n  assignedById = primaryManager.id;\n  assignedByName = primaryManager.name;\n  assignedExt = primaryManager.ext;\n  secondaryExt = secondaryManager.ext;\n\n  fallbackExts = MANAGERS\n    .map(manager => manager.ext)\n    .filter(ext => ext !== assignedExt && ext !== secondaryExt)\n    .join('&');\n\n  nextDutyTurn = dutyTurn === '1' ? '2' : '1';\n} else {\n  assignedById = B2C_MANAGER.id;\n  assignedByName = B2C_MANAGER.name;\n  assignedExt = B2C_MANAGER.ext;\n}\n\nreturn [{\n  json: {\n    ...data,\n    assignedById,\n    assignedByName,\n    assignedExt,\n    secondaryExt,\n    fallbackExts,\n    nextDutyTurn,\n    isCompany: data.clientType === 'COMPANY',\n    dutyDate\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -992,
        16
      ],
