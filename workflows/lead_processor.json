        "jsCode": "const route = $('Route Responsible').first().json;\nconst existingLead = $('Get Existing Lead').first().json.result || null;\n\n// Demo CRM users. Replace with your own active-user lookup/configuration.\nconst ACTIVE_USER_IDS = [101, 102, 103, 104, 105];\n\nconst USER_NAMES = {\n  101: 'Manager A',\n  102: 'Manager B',\n  103: 'Manager C',\n  104: 'Manager D',\n  105: 'Manager E'\n};\n\nconst EXTENSIONS = {\n  101: '201',\n  102: '202',\n  103: '203',\n  104: '204',\n  105: '205'\n};\n\nconst B2C_MANAGER_ID = 103;\nconst B2C_MANAGER_NAME = 'Manager C';\n\nfunction buildResult(\n  finalAssignedById,\n  finalAssignedByName,\n  shouldUpdateDutyTurn,\n  keepExistingResponsible,\n  leadMode,\n  existingLeadAgeSeconds\n) {\n  const responsibleId = Number(finalAssignedById);\n\n  let finalAssignedExt = '';\n\n  if (EXTENSIONS[responsibleId]) {\n    finalAssignedExt = EXTENSIONS[responsibleId];\n  } else if (responsibleId === Number(route.assignedById)) {\n    finalAssignedExt = route.assignedExt || '';\n  }\n\n  return [{\n    json: {\n      ...route,\n      finalAssignedById: responsibleId,\n      finalAssignedByName,\n      finalAssignedExt,\n      shouldUpdateDutyTurn,\n      keepExistingResponsible,\n      leadMode,\n      existingLeadAgeSeconds\n    }\n  }];\n}\n\nif (!existingLead) {\n  return buildResult(\n    route.assignedById,\n    route.assignedByName || `ID ${route.assignedById}`,\n    route.isCompany,\n    false,\n    'NO_EXISTING_LEAD_CREATE_NEW',\n    null\n  );\n}\n\n// B2C callers are routed to the configured B2C manager.\nif (route.clientType === 'PERSON') {\n  return buildResult(\n    B2C_MANAGER_ID,\n    B2C_MANAGER_NAME,\n    false,\n    false,\n    'PERSON_TO_B2C_MANAGER',\n    null\n  );\n}\n\nconst currentResponsibleId = Number(existingLead.ASSIGNED_BY_ID);\nconst isActiveUser = ACTIVE_USER_IDS.includes(currentResponsibleId);\n\nconst createdRaw = existingLead.DATE_CREATE || '';\nconst createdAt = createdRaw ? new Date(createdRaw).getTime() : 0;\nconst ageSeconds = createdAt ? (Date.now() - createdAt) / 1000 : 999999;\n\n// A very fresh CRM record may have just been created by another automation.\n// Keep the routing decision generated for this call.\nif (ageSeconds <= 60) {\n  return buildResult(\n    route.assignedById,\n    route.assignedByName || `ID ${route.assignedById}`,\n    route.isCompany,\n    false,\n    'FRESH_CRM_LEAD_ASSIGN_BY_ROUTER',\n    Math.round(ageSeconds)\n  );\n}\n\n// Existing lead with an active owner keeps its owner.\nif (isActiveUser) {\n  return buildResult(\n    currentResponsibleId,\n    USER_NAMES[currentResponsibleId] || `Current manager ID ${currentResponsibleId}`,\n    false,\n    true,\n    'OLD_ACTIVE_LEAD_KEEP_RESPONSIBLE',\n    Math.round(ageSeconds)\n  );\n}\n\n// Existing lead with an inactive/unknown owner is reassigned by the router.\nreturn buildResult(\n  route.assignedById,\n  route.assignedByName || `ID ${route.assignedById}`,\n  route.isCompany,\n  false,\n  'OLD_INACTIVE_OR_UNKNOWN_ASSIGN_BY_ROUTER',\n  Math.round(ageSeconds)\n);"
      },
