    {
      "parameters": {
        "jsCode": "const data = $('Parse Lead Data').first().json;\n\nconst typeText = data.clientType === 'COMPANY'\n  ? 'Юридическое лицо'\n  : 'Физическое лицо';\n\nreturn [\n  {\n    json: {\n      entityId: $('Duplicate Check').first().json.result.LEAD[0],\n      comment:\n`Голосовой ассистент\n\nИмя: ${data.clientName || 'Не указано'}\nТип клиента: ${typeText}\nГород: ${data.city || 'Не указан'}\n\nТранскрипт разговора:\n\n${data.transcript || ''}`\n    }\n  }\n];"
      },
