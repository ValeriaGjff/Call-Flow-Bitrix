            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"modelUri\": \"gpt://{{$('Edit Fields').first().json.ID_CAT}}/yandexgpt-lite\",\n  \"completionOptions\": {\n    \"stream\": false,\n    \"temperature\": 0,\n    \"maxTokens\": 100\n  },\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"text\": \"Определи тип клиента из текста. Верни только валидный JSON: {\\\"clientType\\\":\\\"PERSON|COMPANY|UNKNOWN\\\"}. Если клиент говорит физическое лицо, физик, частное лицо — верни PERSON. Если говорит юридическое лицо, юр лицо, компания, организация, ООО, ИП — верни COMPANY. Если не понятно — UNKNOWN.\"\n    },\n    {\n      \"role\": \"user\",\n      \"text\": \"Ответ клиента: {{$('Edit Fields').first().json.userText}}\"\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -464,
        64
      ],
      "id": "86beddef-ebf7-47d1-930c-748ea7f3a9ec",
      "name": "Extract Client Type"
    },
    {
      "parameters": {
        "jsCode": "let raw = $json.result?.alternatives?.[0]?.message?.text || '';\nraw = raw.trim();\n\nlet clientType = 'UNKNOWN';\n\ntry {\n  raw = raw\n    .replace(/^```json\\s*/i, '')\n    .replace(/^```/, '')\n    .replace(/```$/i, '')\n    .trim();\n\n  const start = raw.indexOf('{');\n  const end = raw.lastIndexOf('}');\n\n  if (start !== -1 && end !== -1) {\n    const parsed = JSON.parse(raw.slice(start, end + 1));\n    clientType = parsed.clientType || 'UNKNOWN';\n  }\n} catch (e) {\n  clientType = 'UNKNOWN';\n}\n\nconst text = String($('Edit Fields').first().json.userText || '').toLowerCase();\n\nif (text.includes('физ')) clientType = 'PERSON';\nif (text.includes('юр') || text.includes('компан') || text.includes('организац') || text.includes('ооо') || text.includes('ип')) {\n  clientType = 'COMPANY';\n}\n\nreturn [\n  {\n    json: {\n      phone: $('Edit Fields').first().json.phone,\n      clientType,\n      userText: $('Edit Fields').first().json.userText\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -272,
        64
      ],
