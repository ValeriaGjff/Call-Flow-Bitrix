    },
    {
      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body || {};\nconst rawPhone = body.phone || '';\nconst digits = String(rawPhone).replace(/\\D/g, '');\nconst phone = digits ? '+7' + digits.slice(-10) : '';\n\nif (!phone) {\n  throw new Error('Не пришёл phone из Asterisk. body=' + JSON.stringify(body));\n}\n\nreturn [\n  {\n    json: {\n      phone,\n      userText: $json.result || $json.text || '',\n      source: 'telephony_sip',\n      event: 'message',\n      raw: $json\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "85b14266-8aa0-457e-bcbb-45dee391383a",
      "name": "Parse STT Result"
    },
    {
      "parameters": {
        "jsCode": "return [\n  {\n    json: {\n      phone: $json.phone || '',\n      replyText: $json.replyText || 'Извините, я не расслышала. Повторите, пожалуйста.',\n      isCompleted: $json.isCompleted ?? false,\n      userText: $('Parse STT Result').first().json.userText || '',\n      raw: $json\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
