    {
      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body || {};\nconst rawPhone = body.phone || '';\nconst digits = String(rawPhone).replace(/\\D/g, '');\nconst phone = digits ? '+7' + digits.slice(-10) : '';\n\nif (!phone) {\n  throw new Error('Не пришёл phone из Asterisk. body=' + JSON.stringify(body));\n}\n\nreturn [\n  {\n    json: {\n      phone,\n      userText: $json.result || $json.text || '',\n      stage: body.stage || '',\n      source: 'telephony_sip',\n      event: 'message',\n      raw: $json\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
