    {
      "parameters": {
        "jsCode": "const replyText = $json.replyText || '';\n\nreturn [\n  {\n    json: {\n      phone: $json.phone || '',\n      replyText,\n      useThankOk: replyText === '__THANK_OK__',\n      useThankNotOk: replyText === '__THANK_NOT_OK__',\n      isCompleted: $json.isCompleted ?? false,\n      userText: $('Parse STT Result').first().json.userText || '',\n      raw: $json\n    }\n  }\n];"
      },
