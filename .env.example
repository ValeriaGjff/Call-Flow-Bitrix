# n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=UTC

# Optional basic authentication for local demo
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=demo
N8N_BASIC_AUTH_PASSWORD=change_me

# Yandex Cloud - supply your own values
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Bitrix24
# Example: https://your-portal.bitrix24.com/rest/123/your_webhook_token
BITRIX_WEBHOOK_BASE=
# Example: https://your-portal.bitrix24.com
BITRIX_PORTAL_URL=
BITRIX_CHAT_ID=
BITRIX_B2C_MANAGER_ID=103
BITRIX_B2C_MANAGER_NAME=Manager C
BITRIX_CREATED_BY_ID=1
BITRIX_LEAD_STATUS_ID=NEW
